<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:key="pref.root">

    <PreferenceCategory android:title="@string/pref.connection.category">
        <PreferenceScreen
            android:key="pref.adapter.connection"
            android:summary="@string/pref.connection.category.summary"
            android:title="@string/pref.settings"
            app:singleLineTitle="false">

            <org.obd.graphs.preferences.ConnectionTypeListPreference
                android:defaultValue="bluetooth"
                android:dialogTitle="@string/pref.connection.connection_type_dialog"
                android:entries="@array/pref.connection_type_entries"
                android:entryValues="@array/pref.connection_type_array"
                android:key="pref.adapter.connection.type"
                android:title="@string/pref.connection.connection_type"
                app:useSimpleSummaryProvider="true" />

            <PreferenceCategory
                android:key="pref.adapter.connection.type.bluetooth"
                android:title="@string/pref.bluetooth_category">

                <org.obd.graphs.preferences.BluetoothClassicAdaptersListPreferences
                    android:defaultValue="@array/pref.empty_array"
                    android:dialogTitle="@string/pref.adapter_id"
                    android:key="pref.adapter.id"
                    android:title="@string/pref.adapter_id"
                    app:useSimpleSummaryProvider="true" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pref.adapter.connection.type.ble"
                android:title="@string/pref.ble_category">

                <org.obd.graphs.preferences.BleAdaptersListPreferences
                    android:defaultValue="@array/pref.empty_array"
                    android:dialogTitle="@string/pref.ble.adapter_id"
                    android:key="pref.adapter.connection.ble.id"
                    android:title="@string/pref.ble.adapter_id"
                    app:useSimpleSummaryProvider="true" />

                <org.obd.graphs.preferences.BleProfileListPreference
                    android:defaultValue="AUTO"
                    android:dialogTitle="@string/pref.ble.profile"
                    android:key="pref.adapter.connection.ble.profile"
                    android:summary="@string/pref.ble.profile_summary"
                    android:title="@string/pref.ble.profile"
                    app:singleLineTitle="false" />

                <EditTextPreference
                    android:defaultValue=""
                    android:dialogTitle="@string/pref.ble.service_uuid"
                    android:key="pref.adapter.connection.ble.service_uuid"
                    android:title="@string/pref.ble.service_uuid"
                    app:singleLineTitle="false"
                    app:useSimpleSummaryProvider="true" />

                <EditTextPreference
                    android:defaultValue=""
                    android:dialogTitle="@string/pref.ble.notify_uuid"
                    android:key="pref.adapter.connection.ble.notify_uuid"
                    android:title="@string/pref.ble.notify_uuid"
                    app:singleLineTitle="false"
                    app:useSimpleSummaryProvider="true" />

                <EditTextPreference
                    android:defaultValue=""
                    android:dialogTitle="@string/pref.ble.write_uuid"
                    android:key="pref.adapter.connection.ble.write_uuid"
                    android:summary="@string/pref.ble.write_uuid_summary"
                    android:title="@string/pref.ble.write_uuid"
                    app:singleLineTitle="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pref.adapter.connection.type.usb"
                android:title="@string/pref.usb_category">

                <ListPreference
                    android:defaultValue="38400"
                    android:entries="@array/pref.baud_rate_list"
                    android:entryValues="@array/pref.baud_rate_list"
                    android:inputType="number"
                    android:key="pref.adapter.connection.usb.baud_rate"
                    android:summary="@string/pref.usb.baud_rate"
                    android:title="@string/pref.usb.baud_rate"
                    app:singleLineTitle="false"
                    app:useSimpleSummaryProvider="true" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pref.adapter.connection.type.wifi"
                android:title="@string/pref.wifi_category">

                <org.obd.graphs.preferences.WifiSSIDListPreferences
                    android:dialogTitle="@string/pref.adapter_connection_tcp_ssid"
                    android:key="pref.adapter.connection.tcp.ssid"
                    android:title="@string/pref.adapter_connection_tcp_ssid"
                    app:useSimpleSummaryProvider="true" />

                <EditTextPreference
                    android:defaultValue="192.168.0.10"
                    android:dialogTitle="@string/pref.adapter_connection_tcp_host"
                    android:key="pref.adapter.connection.tcp.host"
                    android:title="@string/pref.adapter_connection_tcp_host"
                    app:useSimpleSummaryProvider="true" />

                <EditTextPreference
                    android:defaultValue="35000"
                    android:dialogTitle="Port"
                    android:key="pref.adapter.connection.tcp.port"
                    android:title="@string/pref.adapter_connection_tcp_port"
                    app:useSimpleSummaryProvider="true" />
            </PreferenceCategory>

            <PreferenceCategory android:title="@string/pref.connection.auto_connect.category">
                <ListPreference
                    android:defaultValue="1000"
                    android:dialogTitle="@string/pref.connection.connection_timeout"
                    android:entries="@array/pref.numbers_500_6000"
                    android:entryValues="@array/pref.numbers_500_6000"
                    android:key="pref.adapter.connection.timeout"
                    android:title="@string/pref.connection.connection_timeout"
                    app:useSimpleSummaryProvider="true" />

                <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                    android:defaultValue="false"
                    android:key="pref.vehicle_settings.auto_connect_once_launched"
                    android:summary="@string/pref.vehicle_settings.auto_connect_once_launched_summary"
                    android:title="@string/pref.vehicle_settings.auto_connect_once_launched"
                    app:experimental="false"
                    app:singleLineTitle="false" />

                <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                    android:defaultValue="false"
                    android:key="pref.vehicle_settings.disconnect_when_off"
                    android:summary="@string/pref.vehicle_settings.disconnect_when_off_summary"
                    android:title="@string/pref.vehicle_settings.disconnect_when_off"
                    app:experimental="true"
                    app:singleLineTitle="false" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref.adapter_category">
        <PreferenceScreen
            android:key="pref.init"
            android:summary="@string/pref.init_category_summary"
            android:title="@string/pref.init_category"
            app:singleLineTitle="false">

            <ListPreference
                android:defaultValue="AUTO"
                android:entries="@array/pref.init_protocol"
                android:entryValues="@array/pref.init_protocol"
                android:key="pref.adapter.init.protocol"
                android:title="@string/pref.adapter_init_protocol"
                app:useSimpleSummaryProvider="true" />

            <ListPreference
                android:defaultValue="500"
                android:entries="@array/pref.numbers_500_6000"
                android:entryValues="@array/pref.numbers_500_6000"
                android:inputType="number"
                android:key="pref.adapter.init.delay"
                android:title="@string/pref.adapter_init_delay"
                app:useSimpleSummaryProvider="true" />

            <ListPreference
                android:defaultValue="0"
                android:entries="@array/pref.numbers_500_6000"
                android:entryValues="@array/pref.numbers_500_6000"
                android:inputType="number"
                android:key="pref.adapter.init.delay_after_reset"
                android:title="@string/pref.adapter_delay_reset"
                app:useSimpleSummaryProvider="true" />

            <ListPreference
                android:defaultValue="DEFAULT"
                android:entries="@array/pref.init_sequence"
                android:entryValues="@array/pref.init_sequence"
                android:key="pref.adapter.init.sequence"
                android:title="@string/pref.adapter_init_sequence"
                app:useSimpleSummaryProvider="true" />

            <PreferenceCategory android:title="@string/pref.adapter.diagnostic_request_id.mapping.category">
                <Preference
                    android:key="pref.adapter.init.manage_dri"
                    android:summary="@string/pref.adapter.diagnostic_request_id.manage_summary"
                    android:title="@string/pref.adapter.diagnostic_request_id.manage_title"
                    app:fragment="org.obd.graphs.preferences.dri.DiagnosticRequestIdFragment" />
            </PreferenceCategory>
        </PreferenceScreen>

        <PreferenceScreen
            android:key="pref.adapter"
            android:summary="@string/pref_adapter_settings_summary"
            android:title="@string/pref.adapter.general_settings"
            app:singleLineTitle="false">

            <org.obd.graphs.preferences.AdapterTypeListPreference
                android:defaultValue="DEFAULT"
                android:entries="@array/pref.adapter_type_entries"
                android:entryValues="@array/pref.adapter_type_values"
                android:key="pref.adapter.type"
                android:title="@string/pref.adapter.type"
                app:useSimpleSummaryProvider="true" />

            <PreferenceCategory android:title="@string/pref.adapter_error_handling">
                <SwitchPreferenceCompat
                    android:defaultValue="false"
                    android:key="pref.adapter.error.continue_on_error"
                    android:summary="@string/pref.adapter.error.continue_on_error_summary"
                    android:title="@string/pref.adapter.error.continue_on_error"
                    app:singleLineTitle="false" />

                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="pref.adapter.reconnect"
                    android:summary="@string/pref.adapter_reconnect_summary"
                    android:title="@string/pref.adapter_reconnect"
                    app:singleLineTitle="false" />

                <ListPreference
                    android:defaultValue="6"
                    android:dialogTitle="@string/pref.adapter_reconnect_max_retry"
                    android:entries="@array/pref.numbers_1_20"
                    android:entryValues="@array/pref.numbers_1_20"
                    android:inputType="number"
                    android:key="pref.adapter.reconnect.max_retry"
                    android:title="@string/pref.adapter_reconnect_max_retry"
                    app:singleLineTitle="false"
                    app:useSimpleSummaryProvider="true" />
            </PreferenceCategory>

            <PreferenceCategory android:title="@string/pref.adapter.batch_settings">
                <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                    android:defaultValue="true"
                    android:key="pref.adapter.batch.enabled"
                    android:summary="@string/pref.adapter_batch_enabled_summary"
                    android:title="@string/pref.adapter_batch_enabled"
                    app:singleLineTitle="false" />

                <org.obd.graphs.preferences.components.ExtendedSeekBar
                    android:defaultValue="8"
                    android:key="pref.adapter.batch.size"
                    android:max="24"
                    android:summary="Batch Size for Mode 22"
                    android:title="@string/pref.adapter_batch_mode_22_batch_size"
                    app:dependency="pref.adapter.batch.enabled"
                    app:min="1"
                    app:showSeekBarValue="true"
                    app:singleLineTitle="false"
                    app:useSimpleSummaryProvider="true" />

                <org.obd.graphs.preferences.components.ExtendedSeekBar
                    android:defaultValue="3"
                    android:key="pref.adapter.batch_01.size"
                    android:max="24"
                    android:summary="Batch Size for Mode 01"
                    android:title="@string/pref.adapter_batch_mode_01_batch_size"
                    app:dependency="pref.adapter.batch.enabled"
                    app:min="1"
                    app:showSeekBarValue="true"
                    app:singleLineTitle="false"
                    app:useSimpleSummaryProvider="true" />

                <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                    android:defaultValue="false"
                    android:key="pref.adapter.batch.strict_validation.enabled"
                    android:summary="@string/pref.adapter_batch_strict_validation_enabled_summary"
                    android:title="@string/pref.adapter_batch_strict_validation_enabled"
                    app:singleLineTitle="false" />
            </PreferenceCategory>

            <PreferenceCategory android:title="@string/pref.adapter.general_settings">
                <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                    android:defaultValue="false"
                    android:key="pref.adapter.stn.enabled"
                    android:summary="@string/pref.adapter_stn_enabled_summary"
                    android:title="@string/pref.adapter_stn_enabled" />

                <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                    android:defaultValue="false"
                    android:dependency="pref.adapter.stn.enabled"
                    android:key="pref.adapter.stn.ignore_pids_priorities"
                    android:summary="@string/pref.adapter_stn_ignore_pids_priorities_summary"
                    android:title="@string/pref.adapter_stn_ignore_pids_priorities" />

                <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                    android:defaultValue="false"
                    android:key="pref.adapter.cache.result.enabled"
                    android:summary="@string/pref.experimental_result_cache_enabled"
                    android:title="@string/pref.adapter_cache_result_enabled"
                    app:experimental="true" />

                <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                    android:defaultValue="false"
                    android:key="pref.adapter.responseLength.enabled"
                    android:summary="@string/pref.adapter_calculation_response_frame_enabled_summary"
                    android:title="@string/pref.adapter_calculation_response_frames_enabled"
                    app:singleLineTitle="false" />

                <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                    android:defaultValue="true"
                    android:key="pref.adapter.graceful_stop.enabled"
                    android:summary="@string/pref.adapter_graceful_stop_enabled_summary"
                    android:title="@string/pref.adapter_graceful_stop_enabled"
                    app:singleLineTitle="false" />

                <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                    android:defaultValue="false"
                    android:key="pref.adapter.adaptive.enabled"
                    android:summary="@string/pref.adapter_adaptive_enabled_summary"
                    android:title="@string/pref.adapter_adaptive_enabled" />

                <ListPreference
                    android:defaultValue="6"
                    android:entries="@array/pref.numbers_1_20"
                    android:entryValues="@array/pref.numbers_1_20"
                    android:inputType="number"
                    android:key="pref.adapter.command.freq"
                    android:summary="@string/pref.adapter_command_freq_summary"
                    android:title="@string/pref.adapter_command_freq"
                    app:singleLineTitle="false"
                    app:useSimpleSummaryProvider="true" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref.registry.category">
        <PreferenceScreen
            android:key="pref.registry"
            android:summary="@string/pref_pid_registry_settings_summary"
            android:title="@string/pref.settings"
            app:singleLineTitle="false">

            <org.obd.graphs.preferences.pid.PidDefinitionListPreferences
                android:dialogTitle="@string/pref.pid.manage_dialog"
                android:key="pref.pids.edit"
                android:summary="@string/pref.pid.manage_dialog_summary"
                android:title="@string/pref.pid.manage_dialog"
                app:singleLineTitle="false"
                app:source="edit" />

            <org.obd.graphs.preferences.pid.ModulesListPreferences
                android:dialogTitle="@string/pref.pids.registry.resource_list"
                android:key="pref.pids.registry.list"
                android:summary="@string/pref.pids.registry.resource.list_summary"
                android:title="@string/pref.pids.registry.resource_list"
                app:useSimpleSummaryProvider="true" />

            <SwitchPreferenceCompat
                android:defaultValue="true"
                android:key="pref.adapter.init.fetchSupportedPids"
                android:summary="@string/pref.pids.group.enableCapabilitiesReadings_summary"
                android:title="@string/pref.pids.group.enableCapabilitiesReadings"
                app:singleLineTitle="false" />

            <org.obd.graphs.preferences.pid.FilterBySupportedPIDsAction
                android:defaultValue="false"
                android:key="pref.pids.registry.filter_pids_ecu_supported"
                android:summary="@string/pref.pids_display_only_ecu_supported_summary"
                android:title="@string/pref.pids_display_only_ecu_supported"
                app:singleLineTitle="false" />

            <org.obd.graphs.preferences.pid.FilterByStablePIDsAction
                android:defaultValue="false"
                android:key="pref.pids.registry.filter_pids_stable"
                android:summary="@string/pref.pids_display_only_stable_pids_summary"
                android:title="@string/pref.pids_display_only_stable_pids"
                app:singleLineTitle="false" />

            <org.obd.graphs.preferences.components.ExtendedCheckBoxPreference
                android:defaultValue="false"
                android:key="pref.pids.registry.access_external_storage"
                android:summary="@string/pref.experimental_read_external_storage_enabled"
                android:title="@string/pref.pids.registry.resource.external_storage"
                app:enabled="@bool/FF_READ_RESOURCE_EXTERNAL_STORAGE_ENABLED"
                app:experimental="true"
                app:singleLineTitle="false" />
        </PreferenceScreen>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref.profile.category">
        <PreferenceScreen
            android:key="pref.profiles"
            android:summary="@string/pref_vehicle_profile_settings_summary"
            android:title="@string/pref.settings"
            app:singleLineTitle="false">

            <org.obd.graphs.preferences.profile.ProfileListPreference
                android:key="pref.profile.id"
                android:title="@string/pref.profile.available_list"
                app:useSimpleSummaryProvider="true" />

            <org.obd.graphs.preferences.profile.ProfileResetPreferenceAction
                android:key="pref.profile.reset"
                android:summary="@string/pref.profile.reset_summary"
                android:title="@string/pref.profile.reset" />

            <EditTextPreference
                android:key="pref.profile.about"
                android:title="@string/pref.profile.about_title"
                app:enabled="false"
                app:useSimpleSummaryProvider="true" />
        </PreferenceScreen>
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref.debug_category"
        app:isPreferenceVisible="@bool/DEBUG_BUILD">
        <PreferenceScreen
            android:key="pref.debug"
            android:title="@string/pref.settings">

            <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="pref.debug.logging.enabled"
                android:title="@string/pref.debug_logging_enabled" />

            <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="pref.debug.trip.save.connector_response"
                android:title="@string/pref.debug_trip_save_connector_response" />
        </PreferenceScreen>
    </PreferenceCategory>
</PreferenceScreen>
